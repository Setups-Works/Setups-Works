# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/setups-works

# Auth (admin)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (AI)
GROQ_API_KEY=
GROQ_MODEL=

# SMTP (outgoing mail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# IMAP (incoming mail)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# SEO / crawlers
INDEXNOW_KEY=
CRAWLER_LOG_KEY=

# Perfex CRM web-to-lead form URL
PERFEX_WTL_URL=

# Perfex REST API (Setup > API > API Management). Preferred over the form URL:
# returns the lead id so status can be read back. Without it, falls back to PERFEX_WTL_URL.
PERFEX_API_URL=https://crm.setups.works/api
PERFEX_API_TOKEN=
# Ids from Setup > Leads (source / status) and the staff member leads are assigned to
PERFEX_LEAD_SOURCE_ID=1
PERFEX_LEAD_STATUS_ID=2
PERFEX_ASSIGNED_STAFF_ID=1

# Vercel Cron sends this as "Authorization: Bearer <value>" to /api/cron/perfex-sync
CRON_SECRET=
